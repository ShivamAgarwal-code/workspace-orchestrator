# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-64-char-string

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@postgres:5432/orchestrator
DATABASE_URL_SYNC=postgresql+psycopg2://orchestrator:orchestrator@postgres:5432/orchestrator

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- LLM providers ----
# If unset, the system automatically falls back to the deterministic MockLLMProvider /
# MockEmbeddingProvider so the whole stack (API, orchestration, search, tests) runs with zero keys.
LLM_PROVIDER=anthropic          # anthropic | mock
EMBEDDING_PROVIDER=openai       # openai | mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Google OAuth ----
# Leave MOCK_GOOGLE_API=true to run entirely against seeded fixture data (no Google Cloud project
# required). Set to false + fill in the client id/secret to hit real Gmail/Calendar/Drive APIs.
MOCK_GOOGLE_API=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/drive

# ---- Rate limiting ----
RATE_LIMIT_PER_USER_PER_HOUR=100
GOOGLE_API_UNITS_PER_SECOND=250

# ---- Sync ----
SYNC_INTERVAL_MINUTES=15
